# ── Tanzania Fuel Price API — Environment Variables ──────────────────────────

# Database
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./tanzania_fuel.db

# PostgreSQL / Supabase (recommended for production):
# DATABASE_URL=postgresql://user:password@host:5432/tz_fuel

# Admin endpoint protection — set a strong random secret
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change-me-to-a-strong-secret

# Rate limiting (requests per minute per IP, default 120)
RATE_LIMIT_PER_MINUTE=120

# In-memory cache TTL in seconds (default 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# EIA API key for Brent crude price sync (POST /api/v1/admin/sync-brent)
# Default DEMO_KEY works for ~100 req/day. Register free at https://www.eia.gov/opendata/
EIA_API_KEY=DEMO_KEY
