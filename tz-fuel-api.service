[Unit]
Description=Tanzania Fuel Price API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/apps/tz-fuel-api
EnvironmentFile=/opt/apps/tz-fuel-api/.env
ExecStart=/opt/apps/tz-fuel-api/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --access-log
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tz-fuel-api

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/apps/tz-fuel-api
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
